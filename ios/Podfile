# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'topazProducts' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 + RN 0.81.x compatibility patches:
    # 1) fmt@9.1.x consteval is rejected by Xcode 26 clang; force constexpr fallback.
    # 2) Xcode 26 treats non-modular includes as -Werror in framework builds;
    #    relax it for C/ObjC pods (libwebp, glog) that haven't migrated to modules yet.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        existing_cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
        existing_cflags = [existing_cflags] if existing_cflags.is_a?(String)
        unless existing_cflags.include?('-Wno-error=non-modular-include-in-framework-module')
          existing_cflags << '-Wno-error=non-modular-include-in-framework-module'
        end
        config.build_settings['OTHER_CFLAGS'] = existing_cflags

        existing_cppflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        existing_cppflags = [existing_cppflags] if existing_cppflags.is_a?(String)
        unless existing_cppflags.include?('-Wno-error=non-modular-include-in-framework-module')
          existing_cppflags << '-Wno-error=non-modular-include-in-framework-module'
        end
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = existing_cppflags

        if target.name == 'fmt'
          defines = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defines = [defines] if defines.is_a?(String)
          defines << 'FMT_USE_CONSTEVAL=0' unless defines.include?('FMT_USE_CONSTEVAL=0')
          defines << 'FMT_CONSTEVAL=constexpr' unless defines.include?('FMT_CONSTEVAL=constexpr')
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defines

          # Xcode 26 clang rejects fmt's consteval format-string CTAD. Rewriting
          # the keyword at the preprocessor level forces constexpr fallback
          # without patching upstream fmt headers.
          existing_cppflags << '-Dconsteval=constexpr'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = existing_cppflags
        end
      end
    end
  end
end
